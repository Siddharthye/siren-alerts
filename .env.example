# ─────────────────────────────────────────────────────────────────────────────
# SIREN — every variable below is OPTIONAL.
# Copy to `.env` only if you want to change a default:
#     cp .env.example .env
# With no .env at all, SIREN runs on in-memory storage with seeded demo data.
# ─────────────────────────────────────────────────────────────────────────────

# Identical broadcasts raised within this many seconds collapse into one,
# so a panicking dispatcher cannot send the same evacuation notice five times.
SIREN_DEDUPE_WINDOW_SEC=120

# Upper bound on alerts accepted per minute across all callers.
SIREN_MAX_ALERTS_PER_MINUTE=10

# How long an alert stays active when the caller omits `ttlSec`.
SIREN_DEFAULT_TTL_SEC=3600

# Centre of the seeded demo campus (defaults to KIIT Campus 25, Bhubaneswar).
SIREN_CAMPUS_LAT=20.3536
SIREN_CAMPUS_LNG=85.8195

# ─────────────────────────────────────────────────────────────────────────────
# Persistent storage (production only).
#
# Leave BOTH unset for local development — SIREN then uses in-memory storage
# with best-effort persistence to ./.data, which needs no account and no setup.
#
# Set both to switch to Upstash Redis. Required when deploying to a serverless
# host such as Vercel, where memory does not survive between invocations.
# ─────────────────────────────────────────────────────────────────────────────
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token
